#!/usr/bin/env bash
# Fresh OpenCode install that safely backs up chat history and provides a 100% clean experience.
set -euo pipefail

DATA="${XDG_DATA_HOME:-$HOME/.local/share}/opencode"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/opencode"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/opencode"
DB="$DATA/opencode.db"
BACKUP_ROOT="$HOME/opencode-refresh-backups"

KEEP_TABLES=(
  __drizzle_migrations
  migration
  sqlite_sequence
  project
  project_directory
  worktree
  workspace
  session
  session_v2
  session_message
  message
  part
  todo
  instruction_blob
  instruction_entry
  instruction_state
  blob
  blob_ref
)

STRIP_TABLES=(
  account
  account_state
  control_account
  credential
  kv
  permission
  event
  event_sequence
  schedule
  session_share
  session_inbox
  session_pending
)

usage() {
  cat <<'EOF'
Usage: opencode-refresh [options]

Provides a 100% fresh OpenCode experience with zero migration popups.

Default Behavior (Fresh Clean Slate):
  1. Safely backs up your current chat history and database to ~/opencode-refresh-backups/
  2. Completely wipes all OpenCode data, config, state, and cache
  3. Reinstalls OpenCode cleanly via pacman
  4. Leaves OpenCode completely fresh (0 old sessions, no auto-remigration, brand new feel)

Options:
  --restore [path]    Restore chat history from a previous backup in ~/opencode-refresh-backups/
  -h, --help          Show this help message
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

table_exists() {
  local db="$1" name="$2"
  [[ "$(sqlite3 "$db" "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='$name';")" == "1" ]]
}

count_table() {
  local db="$1" name="$2"
  if table_exists "$db" "$name"; then
    sqlite3 "$db" "SELECT COUNT(*) FROM \"$name\";"
  else
    echo 0
  fi
}

print_counts() {
  local db="$1" label="$2"
  echo "$label"
  for t in session session_v2 message session_message part; do
    printf "  %-18s %s\n" "$t" "$(count_table "$db" "$t")"
  done
}

stop_opencode() {
  if command -v opencode >/dev/null 2>&1; then
    opencode service stop >/dev/null 2>&1 || true
  fi
  pkill -f '/opencode( |$)' >/dev/null 2>&1 || true
  sleep 0.3
}

strip_non_history() {
  local db="$1"
  local sql="" t
  sql+=$'PRAGMA foreign_keys = OFF;\nBEGIN;\n'
  for t in "${STRIP_TABLES[@]}"; do
    if table_exists "$db" "$t"; then
      sql+="DELETE FROM \"$t\";"$'\n'
    fi
  done
  sql+=$'COMMIT;\nPRAGMA foreign_keys = ON;\nVACUUM;\n'
  sqlite3 "$db" "$sql"
  sqlite3 "$db" "PRAGMA integrity_check;" | grep -qx ok || die "stripped history DB failed integrity_check"
}

# Restore mode
if [[ "${1:-}" == "--restore" ]]; then
  TARGET="${2:-}"
  if [[ -z "$TARGET" ]]; then
    echo "Available backups in $BACKUP_ROOT:"
    find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d | sort -r | head -n 10
    echo
    printf "Enter the full backup directory path to restore: "
    read -r TARGET
  fi
  [[ -d "$TARGET" ]] || die "Backup directory not found: $TARGET"
  RESTORE_SRC=""
  if [[ -f "$TARGET/opencode.db.history" ]]; then
    RESTORE_SRC="$TARGET/opencode.db.history"
  elif [[ -f "$TARGET/opencode.db.full" ]]; then
    RESTORE_SRC="$TARGET/opencode.db.full"
  elif [[ -f "$TARGET/opencode.db" ]]; then
    RESTORE_SRC="$TARGET/opencode.db"
  else
    die "No valid database file found in $TARGET"
  fi
  echo "==> Stopping OpenCode"
  stop_opencode
  mkdir -p "$DATA"
  cp -a "$RESTORE_SRC" "$DB"
  chmod 600 "$DB"
  sqlite3 "$DB" "PRAGMA integrity_check;" | grep -qx ok || die "restored DB failed integrity_check"
  echo "✔ Successfully restored database from $RESTORE_SRC"
  print_counts "$DB" "Restored database counts:"
  exit 0
fi

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi
[[ $# -eq 0 ]] || die "unexpected arguments. Try --help"

need sqlite3
need pacman

STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP="$BACKUP_ROOT/$STAMP"
FULL_DB="$BACKUP/opencode.db.full"
HIST_DB="$BACKUP/opencode.db.history"

echo "OpenCode Refresh (100% Fresh Clean Slate)"
echo
echo "Will stop OpenCode, then:"
if [[ -f "$DB" ]]; then
  echo "  backup  $BACKUP (all sessions & messages safely archived)"
else
  echo "  backup  (no live DB to backup; existing backups remain safe)"
fi
echo "  wipe    $DATA"
echo "  wipe    $CONFIG"
echo "  wipe    $STATE"
echo "  wipe    $CACHE"
echo "  run     sudo pacman -S --noconfirm opencode"
echo "  result  100% clean OpenCode with zero auto-remigrations"
echo
if [[ -f "$DB" ]]; then
  print_counts "$DB" "Current database (will be archived to backup):"
  echo
fi
printf "Type yes to continue: "
read -r answer
[[ "$answer" == "yes" ]] || { echo "Aborted."; exit 1; }

echo
echo "==> Stopping OpenCode"
stop_opencode

if [[ -f "$DB" ]]; then
  echo "==> Backing up database"
  mkdir -p "$BACKUP"
  sqlite3 "$DB" ".backup '$FULL_DB'"
  cp -a "$FULL_DB" "$HIST_DB"
  sqlite3 "$FULL_DB" "PRAGMA integrity_check;" | grep -qx ok || die "full backup failed integrity_check"
  strip_non_history "$HIST_DB"
  print_counts "$HIST_DB" "Archived history backup:"
  echo "Backup saved: $BACKUP"
fi

echo "==> Wiping OpenCode directories"
rm -rf "$DATA" "$CONFIG" "$STATE" "$CACHE"

echo "==> Refreshing package"
sudo pacman -S --noconfirm opencode

echo
echo "Done!"
echo "Package: $(pacman -Q opencode 2>/dev/null || true)"
if [[ -f "$FULL_DB" ]]; then
  echo "Backup:  $BACKUP"
fi
echo "Status:  OpenCode is 100% fresh and clean (no legacy migrations or old sessions)."
echo "Tip:     If you ever want to restore your old history, run: opencode-refresh --restore"
